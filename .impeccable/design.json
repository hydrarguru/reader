      "html": "<button class=\"ds-btn-primary\">Create post</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 20px;border-radius:999px;font:600 14px/20px \"Instrument Sans\",system-ui,sans-serif;border:1px solid transparent;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms,transform 150ms;background:hsl(var(--brand));color:hsl(var(--on-brand))}.ds-btn-primary:hover{background:hsl(var(--brand) / 0.9)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--surface-page)),0 0 0 4px hsl(var(--focus));}"
